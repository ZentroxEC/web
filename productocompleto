             EDITABLE
        ====================================================== -->
        <div class="vendedor">

            <div class="vendedor-principal">
                Vendido por
                <strong>ING VINICIO</strong>
            </div>

            <div class="mercadolider">
                MercadoLíder | <strong>+500 ventas</strong>
            </div>

        </div>


        <!-- =====================================================
             COMPRA PROTEGIDA / GARANTÍA
             EDITABLE
        ====================================================== -->
        <div class="seguridad">

            <div class="seguridad-item">

                <div class="icono">
                    🛡️
                </div>

                <div class="seguridad-texto">
                    <strong>Compra Protegida.</strong>
