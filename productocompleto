                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SEGUNDA IMAGEN
         EDITABLE: reemplaza 63664.jpg si quieres otra imagen.
    ========================================================== -->
    <div class="imagen-secundaria">
        <img src="63664.jpg" alt="Información adicional del producto">
    </div>

</div>


