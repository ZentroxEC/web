<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <!-- =========================================================
         EDITABLE: CONFIGURACIÓN GENERAL
         Aquí puedes cambiar el título que aparece en la pestaña.
    ========================================================== -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cable de Poder Delta SATA | ZENTROXEC</title>

    <style>
        /* =========================================================
           EDITABLE: COLORES PRINCIPALES
           Cambia estos valores para adaptar el diseño.
        ========================================================== */
        :root {
            --azul: #3483fa;
            --azul-hover: #246edb;
            --verde: #00a650;
            --texto: #222;
            --texto-secundario: #666;
            --fondo: #ffffff;
            --fondo-suave: #f7f7f7;
            --borde: #eeeeee;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--fondo);
            color: var(--texto);
        }

        .pagina {
            width: 100%;
            max-width: 600px;
            margin: auto;
            background: #fff;
        }

        /* =========================================================
           EDITABLE: IMAGEN PRINCIPAL
           Cambia "63663.jpg" por el nombre de otra imagen.
        ========================================================== */
        .imagen-principal {
            width: 100%;
            background: var(--fondo-suave);
        }

        .imagen-principal img {
            width: 100%;
            display: block;
            height: auto;
        }

        .contenido {
            padding: 24px 20px 40px;
        }

        /* =========================================================
           EDITABLE: NOMBRE DEL PRODUCTO
           El texto se cambia directamente en el HTML.
        ========================================================== */
        .titulo {
            font-size: 25px;
            line-height: 1.25;
            font-weight: 400;
            margin-bottom: 12px;
        }

        .valoracion {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 22px;
        }

        .estrella {
            color: var(--azul);
            font-size: 24px;
        }

        .valoracion strong {
            font-size: 18px;
        }

        .vendidos {
            color: #555;
            font-size: 16px;
        }

        /* =========================================================
           EDITABLE: STOCK
        ========================================================== */
        .stock {
            display: inline-block;
            background: #fff0e6;
            color: #e65b00;
            font-weight: bold;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 15px;
        }

        /* =========================================================
           EDITABLE: PRECIO
           Cambia el número dentro de .precio.
        ========================================================== */
        .precio {
            font-size: 48px;
            font-weight: 400;
            margin-bottom: 10px;
        }

        .precio sup {
            font-size: 27px;
            vertical-align: top;
            position: relative;
            top: 5px;
        }

        .cuotas {
            color: #20a464;
            font-size: 21px;
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .descuento {
            display: inline-block;
            background: #e3efff;
            color: var(--azul);
            padding: 10px 15px;
            border-radius: 5px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        /* =========================================================
           EDITABLE: MEDIOS DE PAGO
           Puedes cambiar, agregar o quitar tarjetas.
        ========================================================== */
        .pagos {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .pagos-titulo {
            color: var(--azul);
            font-size: 19px;
            font-weight: bold;
        }

        .tarjetas {
            display: flex;
            gap: 5px;
            align-items: center;
        }

        .tarjeta {
            width: 48px;
            height: 30px;
            border: 1px solid #ddd;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            background: #fff;
        }

        .entrega {
            font-size: 18px;
            line-height: 1.5;
            margin-bottom: 10px;
        }

        .verde {
            color: var(--verde);
            font-weight: bold;
        }

        .detalle-entrega {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .azul {
            color: var(--azul);
            font-weight: bold;
        }

        .cantidad {
            border: 1px solid var(--borde);
            background: #f8f8f8;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 20px;
            margin-bottom: 20px;
        }

        .cantidad span {
            color: #aaa;
        }

        .flecha {
            color: var(--azul);
            font-size: 30px;
        }

        /* =========================================================
           EDITABLE: BOTONES
           Estos botones se conectarán después con tu sistema real.
        ========================================================== */
        .boton {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 18px;
            font-size: 21px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 14px;
            transition: 0.2s;
        }

        .comprar {
            background: var(--azul);
            color: white;
        }

        .comprar:hover {
            background: var(--azul-hover);
        }

        .carrito {
            background: #e6efff;
            color: var(--azul);
        }

        .carrito:hover {
            background: #d7e6ff;
        }

        /* =========================================================
           EDITABLE: DATOS DEL VENDEDOR
        ========================================================== */
        .vendedor {
            margin-top: 30px;
            margin-bottom: 28px;
        }

        .vendedor-principal {
            font-size: 21px;
            margin-bottom: 5px;
        }

        .vendedor-principal strong {
            color: var(--azul);
        }

        .mercadolider {
            font-size: 18px;
        }

        /* =========================================================
           EDITABLE: GARANTÍA Y COMPRA PROTEGIDA
        ========================================================== */
        .seguridad {
            border-top: 1px solid var(--borde);
            padding-top: 25px;
        }

        .seguridad-item {
            display: flex;
            gap: 15px;
            margin-bottom: 27px;
            align-items: flex-start;
        }

        .icono {
            font-size: 31px;
            min-width: 35px;
        }

        .seguridad-texto {
            font-size: 18px;
            line-height: 1.45;
            color: var(--texto-secundario);
        }

        .seguridad-texto strong {
            color: var(--azul);
            font-weight: 400;
        }

        /* =========================================================
           EDITABLE: IMAGEN SECUNDARIA
           Esta imagen corresponde a la segunda foto enviada.
        ========================================================== */
        .imagen-secundaria {
            width: 100%;
            margin-top: 0;
        }

        .imagen-secundaria img {
            width: 100%;
            display: block;
        }

        /* =========================================================
           DISEÑO PARA CELULARES
        ========================================================== */
        @media (max-width: 480px) {
            .contenido {
                padding: 20px 18px 35px;
            }

            .titulo {
                font-size: 23px;
            }

            .precio {
                font-size: 43px;
            }

            .cuotas {
                font-size: 19px;
            }

            .boton {
                font-size: 20px;
            }
        }
    </style>
</head>

<body>

<div class="pagina">

